# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=

# Канал, на который нужно подписаться. Бот должен быть в нём администратором.
CHANNEL=@vanillapropsy

# Telegram ID админов через запятую — им доступна команда /stats.
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Через сколько часов после гейта напомнить тем, кто не подписался. 0 — выключить.
REMINDER_HOURS=24

LOG_LEVEL=INFO
