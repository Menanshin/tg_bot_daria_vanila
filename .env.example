# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=

# Канал, на который нужно подписаться. Бот должен быть в нём администратором.
CHANNEL=@vanillapropsy

# Telegram ID админов через запятую — им доступны кнопка «📊 Статистика» и /stats.
# Пример: ADMIN_IDS=111111111,222222222
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Через сколько часов после гейта напомнить тем, кто не подписался. 0 — выключить.
REMINDER_HOURS=24

# Username Даши (без @) — кнопка «Написать «близость»» в конце результата ведёт к ней в личку.
# Если строку удалить — по умолчанию daria_vanilla.
CONTACT=daria_vanilla

# Через сколько минут после /start прислать дневник самопознания (PDF), если тест не начат. 0 — выключить.
DIARY_DELAY_MINUTES=3

# Через сколько минут после прохождения теста прислать сообщение «Пиши «близость»». 0 — сразу.
CTA_DELAY_MINUTES=5

LOG_LEVEL=INFO
